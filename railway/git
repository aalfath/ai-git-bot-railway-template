#!/bin/sh
# git wrapper (first in PATH): AI Git Bot runs git with GIT_CONFIG_NOSYSTEM=1 and a
# scrubbed environment, so memory limits for clone/fetch (index-pack) go on the
# command line. Railway shows the host's 32+ CPUs, and one index-pack thread per CPU
# can exceed a 0.5 GB service.
exec /usr/bin/git -c pack.threads=2 -c pack.windowMemory=64m -c pack.deltaCacheSize=32m \
  -c core.packedGitLimit=128m -c core.packedGitWindowSize=32m -c core.bigFileThreshold=16m "$@"
